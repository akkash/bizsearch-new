      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/deal-pipeline",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/commissions",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/report-generator",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/leads",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/pipeline",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/pipeline/:path*",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/advisor",
      "destination": "/api/prerender?type=spa"
