    {
      "source": "/notifications",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/messages",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/add-business-listing",
      "destination": "/api/prerender?type=spa"
