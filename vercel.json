{
  "redirects": [
    {
      "source": "/api/docs",
      "destination": "/docs",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/businesses",
      "permanent": true
    },
    {
      "source": "/advisors",
      "destination": "/franchises",
      "permanent": false
    },
    {
      "source": "/franchise-map",
      "destination": "/franchises",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/prerender?type=page&path=home"
    },
    {
      "source": "/franchise/:slug/apply",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/franchise/:slug/locations",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/franchise/edit/:id",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/business/edit/:id",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/franchise/:slug",
      "destination": "/api/prerender?type=franchise&slug=:slug"
    },
    {
      "source": "/business/:slug",
      "destination": "/api/prerender?type=business&slug=:slug"
    },
    {
      "source": "/franchises",
      "destination": "/api/prerender?type=page&path=franchises"
    },
    {
      "source": "/businesses",
      "destination": "/api/prerender?type=page&path=businesses"
    },
    {
      "source": "/docs",
      "destination": "/api/prerender?type=page&path=docs"
    },
    {
      "source": "/about",
      "destination": "/api/prerender?type=page&path=about"
    },
    {
      "source": "/contact",
      "destination": "/api/prerender?type=page&path=contact"
    },
    {
      "source": "/login",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/signup",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/forgot-password",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/reset-password",
      "destination": "/api/prerender?type=spa"
    },
    {
      "source": "/onboarding",
