# Supabase (client-safe keys only — anon key is publishable by design)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mapbox (client token — restrict by URL in Mapbox dashboard)
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# Server-only — never commit; used by deploy/seed/validation scripts:
# SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# CMD_API_KEY=your-gemini-api-key
# EDGE_FUNCTION_SECRET=random-cron-secret-for-internal-edge-calls
# TEST_ACCOUNT_PASSWORD=TestPass123!
