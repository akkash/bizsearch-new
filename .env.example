# Supabase (client-safe keys only — anon key is publishable by design)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mapbox (client token — restrict by URL in Mapbox dashboard)
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# Server-only secrets — set in Supabase Edge Function secrets, NOT in Vite env:
# GOOGLE_AI_API_KEY=your-gemini-api-key
# EDGE_FUNCTION_SECRET=random-cron-secret-for-internal-edge-calls
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
