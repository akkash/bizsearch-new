# Supabase (client-safe keys only — anon key is publishable by design)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Mapbox (client token — restrict by URL in Mapbox dashboard)
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# VABGO commercial property marketplace.
# Browser GET /api/search is allowed from https://*.bizsearch.in. Local dev
# proxies /vabgo-api → vabgo.com (unknown origins still get 403). Iframes stay blocked.
VITE_VABGO_ORIGIN=https://vabgo.com
# Optional API host (defaults to https://www.vabgo.com to avoid CORS on the apex 308)
# VITE_VABGO_API_ORIGIN=https://www.vabgo.com

# Server-only — never commit; used by deploy/seed/validation scripts:
# SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# (alias: SUPABASE_SERVICE_ROLE)
# CMD_API_KEY=your-gemini-api-key
# EDGE_FUNCTION_SECRET=random-cron-secret-for-internal-edge-calls
# TEST_ACCOUNT_PASSWORD=TestPass123!
